{
    email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 15MB
    }
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    handle {
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }
}
